{
  "name": "fenestra",
  "version": "0.1.0",
  "private": true,
  "description": "Fenestra — only a shell, everything else is a plugin",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate:test": "cargo test -p fenestra-gate",
    "core:test": "pnpm --filter @fenestra/core test",
    "core:typecheck": "pnpm --filter @fenestra/core typecheck",
    "plugins:typecheck": "pnpm --filter @fenestra/plugin-* typecheck",
    "tauri": "tauri",
    "ui:build": "pnpm --filter @fenestra/ui build",
    "build": "pnpm --filter @fenestra/ui build",
    "test": "pnpm --filter @fenestra/core test",
    "typecheck": "pnpm --filter @fenestra/core typecheck && pnpm --filter @fenestra/plugin-* typecheck"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22",
    "typescript": "^5.9.3"
  }
}
