{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fenestra",
  "version": "0.2.0",
  "identifier": "dev.codecloud.fenestra",
  "build": {
    "beforeBuildCommand": "pnpm --filter @fenestra/ui build",
    "frontendDist": "../../../packages/ui/dist"
